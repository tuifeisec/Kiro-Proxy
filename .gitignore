# IDE and local agent state
.kiro/
.vscode/
.idea/
.codegraph/*
!.codegraph/.gitignore

# Go build and test output
*.exe
*.exe~
*.syso
*.test
*.out
coverage.out
.gocache/

# Keep Windows resource source files; ignore generated build output.
build/*
!build/windows/
build/windows/*
!build/windows/kiro-proxy.rc
!build/windows/kiro-proxy.ico

# Runtime data
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
log/

# Local secrets and configuration
config.yaml
.env
.env.*
!.env.example
certs/

# Frontend dependencies and generated assets
frontend/node_modules/
frontend/dist/
frontend-inspector/node_modules/
frontend-inspector/dist/
go/web/admin/node_modules/
go/web/admin/dist/
.vben-template/node_modules/

# Generated documentation/cache directories
doc/ai-proxy/
doc/openai/

# Temporary and operating-system files
*.tmp
*.temp
*.bak
Thumbs.db
Desktop.ini
.DS_Store

# Local debug captures and scratch files
*.prof
*.coverprofile

# Keep source/configuration JSON files trackable. Ignore only known captures.
jilu/*.json

# One-off local scripts
test_sse.ps1
install-ca.ps1

# Cloned external study project (juhe-ai) — do not push to GitHub
xuexi/
